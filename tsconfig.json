{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "allowJs": true,
    "checkJs": false,

    "types": ["node"],

    "declaration": true,
    "sourceMap": true,

    "rootDir": ".",
    "outDir": "dist",

    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  "include": ["apps/**/*.ts", "src/**/*.ts", "tests/**/*.ts"],

  "exclude": ["node_modules", "dist", "fixtures", "examples"]
}
