  },
  "description": "Software Upgrade & Change Intelligence CLI for analyzing version changes, detecting breaking changes, mapping affected code, assessing migration risks, and reviewing verification evidence. Shadow Upgrade and deeper before/after validation planned for V2.",
  "keywords": [
    "software upgrade",
    "software change intelligence",
    "upgrade impact analysis",
    "change impact analysis",
    "dependency upgrades",
    "dependency management",
    "breaking changes",
    "upgrade analyzer",
    "software migration",
    "migration planning",
    "code impact analysis",
    "static analysis",
    "code analysis",
    "version compatibility",
    "compatibility checker",
    "upgrade risk analysis",
    "regression testing",
    "upgrade verification",
    "software maintenance",
    "release safety",
    "shadow upgrade",
    "change detection",
    "automated migration",
    "codemod",
    "developer tools",
    "cli",
    "npm",
    "nodejs",
    "javascript",
    "typescript",
    "express"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "upgradex": "dist/apps/cli/index.js"
  },
  "files": [
    "dist",
    "rules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivamSrivastava0/upgradex.git"
  },
  "bugs": {
    "url": "https://github.com/ShivamSrivastava0/upgradex/issues"
  },
  "homepage": "https://github.com/ShivamSrivastava0/upgradex",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests --pool=threads",
    "test:watch": "vitest --dir tests --pool=threads",
    "lint": "eslint .",
    "quality": "npm run typecheck && npm test && npm run lint && npm run format:check",
    "test:artifact": "node scripts/check-package-artifact.mjs",
    "validate:release": "node scripts/check-release-metadata.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run quality && npm run validate:release && npm run test:artifact",
    "format": "prettier --write .",
    "format:check": "prettier --check . --end-of-line auto"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
